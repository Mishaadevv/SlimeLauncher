{
  "name": "slimelauncher",
  "version": "1.18.4",
  "description": "SlimeLauncher",
  "author": "SlimeLauncher Team",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n MAIN,RENDERER -c green,cyan \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "cross-env NODE_ENV=development tsc -p electron/tsconfig.json --watch",
    "dev:renderer": "cross-env NODE_ENV=development vite",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.4.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.slimelauncher.app",
    "productName": "SlimeLauncher",
    "publish": {
      "provider": "github",
      "owner": "Mishaadevv",
      "repo": "SlimeLauncher",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "ico.ico.png"
    ],
    "win": {
      "icon": "ico.ico.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SlimeLauncher",
      "include": "build/installer.nsh"
    }
  }
}
